# =============================================================================
# .env.example — 이 파일을 복사해서 .env로 만든 뒤 값을 채우세요.
# cp .env.example .env
# .env는 .gitignore에 포함되어 있어 Git에 올라가지 않습니다.
# =============================================================================

# ── 바이낸스 API ─────────────────────────────────────────────────────────────
# Testnet(모의투자) 사용 시에는 반드시 바이낸스 Testnet 전용 API 키를 발급받아 기입하세요.
BINANCE_API_KEY=여기에_바이낸스_API_키_입력
BINANCE_API_SECRET=여기에_바이낸스_시크릿_키_입력

# ── 텔레그램 봇 ──────────────────────────────────────────────────────────────
# BotFather(/newbot)에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=여기에_텔레그램_봇_토큰_입력
# 알림을 받을 채팅 ID (개인: 숫자, 채널: @채널명)
TELEGRAM_CHAT_ID=여기에_채팅_ID_입력

# ── 거래 모드 및 모의투자(Testnet) ──────────────────────────────────────────
# IS_PAPER_TRADING
#   true : API 연결 없이 내부에서 가상 잔고로만 시뮬레이션 (가장 안전, 내장 잔고 사용)
#   false: 실제 바이낸스 거래소로 주문 집행 (아래 USE_TESTNET에 따라 네트워크 결정)
IS_PAPER_TRADING=true

# USE_TESTNET (IS_PAPER_TRADING=false 일 때만 유효)
#   true : 바이낸스 모의투자(Testnet) 네트워크 사용 (Testnet 전용 API 키 필요)
#   false: 바이낸스 실거래(Mainnet) 네트워크 사용 (실거래 전용 API 키 필요)
USE_TESTNET=true

